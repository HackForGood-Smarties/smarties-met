{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smarties-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // D1 — primary store (caregivers, seniors, providers, trips, events)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smarties",
      "database_id": "REPLACE_AFTER_wrangler_d1_create",
      "migrations_dir": "migrations"
    }
  ],

  // Durable Objects — one instance per active trip; holds in-memory stage state
  // and broadcasts WebSocket updates to connected caregiver dashboards.
  "durable_objects": {
    "bindings": [
      {
        "name": "TRIP_DO",
        "class_name": "TripRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["TripRoom"]
    }
  ],

  // KV — light cache (eligibility verdicts, postal-code → providers)
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_AFTER_wrangler_kv_namespace_create"
    }
  ],

  // Workers AI — SEA-LION (AI Singapore) lives here.
  "ai": {
    "binding": "AI"
  },

  // Vars: tweak demo behaviour without code changes.
  "vars": {
    "DEMO_AUTO_ADVANCE_SECONDS": "6",
    "ALLOW_ANY_ORIGIN": "true"
  }
}
