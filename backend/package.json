{
  "name": "smarties-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute smarties --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute smarties --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state && npm run db:init && npm run db:seed",
    "db:init:remote": "wrangler d1 execute smarties --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute smarties --remote --file=./seed.sql",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.103.2"
  }
}
